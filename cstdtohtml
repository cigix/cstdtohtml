#!/usr/bin/env python3

import os
import subprocess
import sys

import htmlwriter
import linker
import markdownwriter
import pages
import utils
from toc import TOC, TOCMatcher

def pdftotext(file):
    '''pdftotext(file): Run the file through `pdftotext -layout`.

    If the subprocess fails, its stderr gets printed to stderr, and its return
    status is passed to sys.exit().

    Parameters:
        - file: str, path to the PDF file

    Return: str, stdout of the subprocess.'''
    process = subprocess.run(["pdftotext", "-layout", file, "-"],
                             capture_output=True, text=True)
    if process.returncode != 0:
        print(process.stderr, end='', file=sys.stderr)
        sys.exit(process.returncode)
    return process.stdout

def texttopages(text):
    '''texttopages(text): Split the text into groups of Pages.

    Parameters:
        - text: str, the output of `pdftotext`

    Return: dict of str to list of Pages. The keys of the dict are "cover",
    "toc", "foreword", "intro", "contents", and "biblio".
    '''
    unstructuredpages = [pages.Page(p) for p in text.split('\f') if p]

    coverbegin = 0
    # The cover and the first page of content have a common subheader
    front_header = utils.groupwords(unstructuredpages[coverbegin].content[0])
    tocbegin = coverbegin + 1
    # There is an empty page between cover and ToC
    while (unstructuredpages[tocbegin].content
           and unstructuredpages[tocbegin].content[0].lstrip() != "Contents"):
        tocbegin += 1
    forewordbegin = tocbegin + 1
    while unstructuredpages[forewordbegin].content[0].lstrip() != "Foreword":
        forewordbegin += 1
    introbegin = forewordbegin + 1
    while unstructuredpages[introbegin].content[0].lstrip() != "Introduction":
        introbegin += 1
    contentsbegin = introbegin + 1
    while (utils.groupwords(unstructuredpages[contentsbegin].content[0])
           != front_header):
        contentsbegin += 1
    bibliobegin = contentsbegin + 1
    while unstructuredpages[bibliobegin].content[0].lstrip() != "Bibliography":
        bibliobegin += 1
    indexbegin = bibliobegin + 1

    pagegroups = dict()
    pagegroups["cover"] = unstructuredpages[coverbegin:tocbegin]
    pagegroups["toc"] = unstructuredpages[tocbegin:forewordbegin]
    pagegroups["foreword"] = unstructuredpages[forewordbegin:introbegin]
    pagegroups["intro"] = unstructuredpages[introbegin:contentsbegin]
    pagegroups["contents"] = unstructuredpages[contentsbegin:bibliobegin]
    pagegroups["biblio"] = unstructuredpages[bibliobegin:indexbegin]
    return pagegroups

def pagestostructures(pagegroups, withcover, withfootnotes, tocgroup):
    '''pagestostructures(pagegroups, withcover, withfootnotes, tocgroup): Parse
    the Pages into StructuredPages and TOC.

    Parameters:
        - pagegroups: dict of str to list of Pages, the groups of pages.
        - withcover: container of str, the groups that start with a cover page.
        - withfootnotes: container of str, the groups that contain footnotes.
        - tocgroup: str, the name of the group that contains the Table of
          Contents.

    Return: dict of str to (StructuredPage or TOC), the TOC and the
    StructuredPages, with the same keys as `pagegroups.

    For groups in `withcover`, the page will be a CoverPage.
    '''
    toc = TOC(pagegroups[tocgroup])
    # remove Index
    toc.titles.pop()
    tocmatcher = TOCMatcher(toc)

    structuredgroups = dict()
    for group, unstructuredpages in pagegroups.items():
        if group == tocgroup:
            continue
        if group in withcover:
            structuredpages = [
                    pages.CoverPage(unstructuredpages[0], tocmatcher)
                ]
            structuredpages += [
                    pages.StructuredPage(p, tocmatcher)
                    for p in unstructuredpages[1:]
                ]
        else:
            structuredpages = [
                    pages.StructuredPage(p, tocmatcher)
                    for p in unstructuredpages
                ]

        if group in withfootnotes:
            for i, p in enumerate(structuredpages):
                # Fix N3220footnote1997: it is not a footnote, just unfortunate
                # number + parens combo
                if 1997 in p.footnotes.keys():
                    p.elements[-1].addcontent("1997)"
                                              + p.footnotes[1997][0].content)
                    p.elements.extend(p.footnotes[1997][1:])
                    del p.footnotes[1997]
                p.reindentcodes()
                p.reworkfootnotes()
                p.fixfootnoterefs()
                p.putfootnoteplaceholders()
                # Fix N3220footnote70: it is on the next page
                if 69 in p.footnotes.keys():
                    p._putfootnoteplaceholder(70)

        mergedpage = pages.mergepages(structuredpages)

        linker.putlinksplaceholders(mergedpage.elements)
        if group in withfootnotes:
            for elems in mergedpage.footnotes.values():
                linker.putlinksplaceholders(elems)

        structuredgroups[group] = mergedpage

    structuredgroups[tocgroup] = toc
    return structuredgroups

def structuredtohtml(structuredgroups, todump, title, header):
    '''structuredtohtml(structuredgroups, todump, title, header): Turn the
    StructuredPages to HTML.

    Parameters:
        - structuredgroups: dict of str to (StructuredPage or TOC), the
          StructuredPages.
        - todump: iterable of str, the sequence of groups to turn to HTML.
        - title: str, the title of the HTML document.
        - header: iterable of str, the header of the document.

    Return: str, a HTML document.
    '''
    headertag = htmlwriter.Tag("header", [htmlwriter.Tag("div", h)
                                       for h in header])
    body = htmlwriter.Tag("body", headertag)

    allfootnotes = dict()
    donefootnotes = set()
    for group in todump:
        if isinstance(structuredgroups[group], TOC):
            htmlwriter.eatTOC(body, structuredgroups[group])
        else:
            allfootnotes.update(structuredgroups[group].footnotes)
            htmlwriter.eatStructuredPage(body, structuredgroups[group],
                                         donefootnotes)

    todofootnotes = allfootnotes.keys() - donefootnotes
    if todofootnotes:
        body.add(htmlwriter.Tag("hr /"))
        body.add(htmlwriter.Tag("i", "Footnotes should be at the end of the"
            " sections they appear in, but it seems we did not find those:"))

        htmlwriter.eatfootnotes(body, {
                footnote: elems
                for footnote, elems in allfootnotes.items()
                if footnote in todofootnotes
            })

    html = f"""<!DOCTYPE html>
<html lang="en">
<!-- This document was generated automatically by cstdtohtml -->
<head>
  <meta charset="utf-8">
  <title>{title}</title>
</head>
{body.tohtml()}</html>
"""
    return html

def structuredtomd(structuredgroups, todump, title):
    '''structuredtomd(structuredgroups, todump, title): Turn the StructuredPages
    to Markdown.

    Parameters:
        - structuredgroups: dict of str to (StructuredPage or TOC), the
          StructuredPages.
        - todump: iterable of str, the sequence of groups to turn to Markdown.
        - title: str, the title of the document.

    Return: str, a Markdown document.
    '''
    header = f'''---
title: '{title}'
...
'''
    groups = [header]
    allfootnotes = dict()
    donefootnotes = set()
    for g in todump:
        group = structuredgroups[g]
        if isinstance(group, TOC):
            groups.append(markdownwriter.eatTOC(group))
        else:
            allfootnotes.update(group.footnotes)
            groups.append(markdownwriter.eatStructuredPage(group,
                                                           donefootnotes))

    todofootnotes = allfootnotes.keys() - donefootnotes
    if todofootnotes:
        groups.append("-----")
        groups.append("_Footnotes should be at the end of the sections they"
                      " appear in, but it seems we\n"
                      " did not find those:_")
        groups.append(markdownwriter.eatfootnotes({
                footnote: elems
                for footnote, elems in allfootnotes.items()
                if footnote in todofootnotes
            }))

    return '\n'.join(groups)

def main(argv):
    usagestr = ("Usage: " + os.path.basename(argv[0]) +
                " <C Standard Draft PDF file> [output HTML file]")
    if not 1 < len(argv) < 4:
        print(usagestr, file=sys.stderr)
        return 1
    if argv[1] in ["-h", "-help", "--help"]:
        print(usagestr)
        return 0
    inputfile = argv[1]
    if len(argv) == 3:
        outputfile = argv[2]
    else:
        outputfile = os.path.splitext(inputfile)[0] + ".html"

    text = pdftotext(inputfile)
    # for debugging purposes
    #with open(".cstdtohtml_raw", 'w') as f:
    #    f.write(text)

    pagegroups = texttopages(text)
    isostd = pagegroups["cover"][0].header[0].split('—')[0]
    header = utils.groupwords(pagegroups["cover"][0].content[0])
    structuredgroups = pagestostructures(pagegroups, ("cover", "contents"),
                                         ("contents",), "toc")

    todump = ("cover", "toc", "foreword", "intro", "contents", "biblio")
    html = structuredtohtml(structuredgroups, todump, isostd, header)
    markdown = structuredtomd(structuredgroups, todump, isostd)
    with open(outputfile, "wt") as out:
        out.write(html)
    with open("test.md", "wt") as out:
        out.write(markdown)
    return 0

if __name__ == '__main__':
    sys.exit(main(sys.argv))
